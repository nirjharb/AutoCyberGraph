# AutoCyberGraph environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=sqlite:///./autocybergraph.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://autocybergraph:CHANGE_ME@db-host:5432/autocybergraph

# Auth — REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-only-change-me-in-production-0123456789abcdef
JWT_TTL_MINUTES=480

# CORS — comma separated allowlist of frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# --- CyberAdvisor (optional LLM backend; rules engine used when empty) ---
AI_API_KEY=
AI_BACKEND=rules

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_DIR=uploads
MAX_UPLOAD_MB=10

# --- Rate limiting ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_ADVISOR=30/minute

# --- Demo ---
SEED_DEMO_ON_STARTUP=false

# --- Frontend (Vite build-time) ---
VITE_API_URL=
