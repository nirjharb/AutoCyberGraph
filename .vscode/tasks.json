{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "setup: install everything",
      "dependsOrder": "sequence",
      "dependsOn": ["setup: backend deps", "setup: frontend deps", "setup: seed demo data"],
      "group": "build"
    },
    {
      "label": "setup: backend deps",
      "type": "shell",
      "command": "python3 -m pip install -r requirements.txt",
      "windows": { "command": "python -m pip install -r requirements.txt" },
      "cwd": "${workspaceFolder}/backend",
      "problemMatcher": []
    },
    {
      "label": "setup: frontend deps",
      "type": "shell",
      "command": "npm install",
      "cwd": "${workspaceFolder}/frontend",
      "problemMatcher": []
    },
    {
      "label": "setup: seed demo data",
      "type": "shell",
      "command": "python3 manage.py seed",
      "windows": { "command": "python manage.py seed" },
      "cwd": "${workspaceFolder}/backend",
      "problemMatcher": []
    },
    {
      "label": "dev: backend (uvicorn --reload)",
      "type": "shell",
      "command": "python3 manage.py run",
      "windows": { "command": "python manage.py run" },
      "cwd": "${workspaceFolder}/backend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: frontend (vite)",
      "type": "shell",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "test: backend (pytest)",
      "type": "shell",
      "command": "python3 -m pytest tests/ -q",
      "windows": { "command": "python -m pytest tests/ -q" },
      "cwd": "${workspaceFolder}/backend",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "test: frontend (vitest)",
      "type": "shell",
      "command": "npx vitest run",
      "cwd": "${workspaceFolder}/frontend",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "build: frontend (production)",
      "type": "shell",
      "command": "npm run build",
      "cwd": "${workspaceFolder}/frontend",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "reset: demo database",
      "type": "shell",
      "command": "python3 manage.py reset",
      "windows": { "command": "python manage.py reset" },
      "cwd": "${workspaceFolder}/backend",
      "problemMatcher": []
    }
  ]
}
